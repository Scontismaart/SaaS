# Used only with CADDY_SITE_MODE=final after melpis.it and app.melpis.it DNS
# resolve to this VM. Keeping it separate prevents premature final-domain TLS.
(melpis_app) {
	encode zstd gzip
	request_body {
		max_size 22MB
	}
	@backend path /api/* /webhooks/* /docs* /redoc* /openapi.json
	reverse_proxy @backend api:8000
	reverse_proxy web:80
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	log {
		output stdout
		format filter {
			request>uri regexp `\?.*$` `?[QUERY REDACTED]`
			request>headers>Cookie delete
			request>headers>Referer delete
			resp_headers>Set-Cookie delete
			resp_headers>Location delete
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>X-API-Key delete
			request>headers>X-CSRF-Token delete
		}
	}
}

melpis.it {
	import melpis_app
}

app.melpis.it {
	redir https://melpis.it/app/ 308
}
